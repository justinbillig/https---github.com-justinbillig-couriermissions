---
import SiteLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site.js";
import { getInvolvedPhotos } from "../data/get-involved.js";
import { givingTuesdayTeaser } from "../data/giving-tuesday-2026.js";

const carouselPhotos = getInvolvedPhotos.map(({ image, alt, caption, fit }) => ({
  src: image.src,
  alt,
  caption,
  fit: fit ?? "cover",
}));
---

<SiteLayout title="Get Involved" description="Pray with us, give, come to Kenya or invite your church to join the work. We’d be glad to talk." heroImage={getInvolvedPhotos[0].image}>
  <section class="page-hero get-involved-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__content">
        <p class="eyebrow">Get involved</p>
        <h1>Come be part of the work.</h1>
        <p class="section-lead">You can pray, give, come to Kenya or bring your church alongside local leaders. We’d be glad to talk with you.</p>
      </div>
    </div>
  </section>

  <section class="involvement-gallery page-section">
    <div class="container">
      <div
        class="photo-carousel"
        data-photo-carousel
        data-photos={JSON.stringify(carouselPhotos)}
        role="region"
        aria-roledescription="carousel"
        aria-live="off"
        aria-label="Courier Missions photos"
      >
        <div class="photo-carousel__stage">
          <div class="photo-carousel__track">
            {getInvolvedPhotos.slice(0, 3).map((photo, index) => (
              <figure
                class="photo-carousel__slide"
                data-carousel-slide
                role="group"
                aria-roledescription="slide"
                aria-label={`${index + 1} of ${getInvolvedPhotos.length}`}
              >
                <img
                  class:list={["photo-carousel__image", photo.fit === "contain" && "photo-carousel__image--contain"]}
                  data-carousel-image
                  src={photo.image.src}
                  alt={photo.alt}
                  width={photo.image.width}
                  height={photo.image.height}
                  loading="eager"
                  decoding="async"
                />
                <figcaption data-carousel-caption>{photo.caption}</figcaption>
              </figure>
            ))}
          </div>
          <div class="photo-carousel__arrows" aria-label="Carousel controls">
            <button class="photo-carousel__arrow" type="button" data-carousel-previous aria-label="Show previous photos">
              <span aria-hidden="true">&larr;</span>
            </button>
            <button class="photo-carousel__arrow" type="button" data-carousel-next aria-label="Show next photos">
              <span aria-hidden="true">&rarr;</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="giving-tuesday-teaser page-section" id="giving-tuesday-2026">
    <div class="container">
      <div class="giving-tuesday-teaser__panel">
        <p class="eyebrow">{givingTuesdayTeaser.eyebrow}</p>
        <h2>{givingTuesdayTeaser.title}</h2>
        <p>{givingTuesdayTeaser.description}</p>
        <a class="text-link" href={givingTuesdayTeaser.href}>
          {givingTuesdayTeaser.linkLabel} →
        </a>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container card-grid get-involved-cards">
      <article class="mini-card get-involved-cards__give">
        <p class="eyebrow">Give</p>
        <h3>Your gift helps the work keep going.</h3>
        <p>Give once or monthly. Here are approximate program costs the directors shared with us:</p>
        <ul>
          <li>$10/month for one student’s one meal a day; $50/month for five students’ one meal a day each.</li>
          <li>$150/month for daily security at the Kakamega School for the Deaf.</li>
          <li>About $1,200 for a medical clinic.</li>
          <li>About $15,000 for a church and restroom facility.</li>
          <li>$12 for a Bible.</li>
        </ul>
        <p class="form-note">These are approximate program costs.</p>
        <p>Thinking about a stock or legacy gift, or giving through a donor-advised fund? <a href="/contact/?interest=Stock%20or%20legacy%20gift">Let’s talk through the contact form</a>.</p>
        <a class="button button--primary" href={site.donateHref}>Donate</a>
      </article>
      <article class="mini-card">
        <p class="eyebrow">Pray</p>
        <h3>Would you pray with us?</h3>
        <p>Pray for students, pastors, families, local leaders and wisdom for the work ahead.</p>
        <a class="text-link" href="/contact/?interest=Pray">Get in touch about prayer updates</a>
      </article>
      <article class="mini-card">
        <p class="eyebrow">Go</p>
        <h3>Come to Kenya.</h3>
        <p>We take an annual mission trip to Kenya. Want to know about the next trip? Send us a note.</p>
        <a class="text-link" href="/contact/?interest=Go on a trip">Ask about going</a>
      </article>
      <article class="mini-card">
        <p class="eyebrow">Partner</p>
        <h3>Bring your church alongside.</h3>
        <p>Would your church like to pray, give or serve alongside local leaders? Let’s talk.</p>
        <a class="text-link" href="/contact/?interest=Partner as a church">Start a conversation</a>
      </article>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-cream);">
    <div class="container narrow">
      <p class="eyebrow">Follow along</p>
      <h2 class="section-heading">Follow the work as it happens.</h2>
      <a class="button button--primary" href="https://facebook.com/couriermissions" target="_blank" rel="noreferrer">Follow on Facebook</a>
    </div>
  </section>

  <div class="donate-cta section">
    <div class="container">
      <div class="donate-cta__inner">
        <div>
          <h2>Your gift joins the work.</h2>
          <p class="donate-cta__copy">Give and help meet needs as they arise.</p>
        </div>
        <div class="donate-cta__actions">
          <a class="button button--primary" href={site.donateHref}>Donate</a>
          <a class="text-link" href="/contact/">Get in touch</a>
        </div>
      </div>
    </div>
  </div>
</SiteLayout>

<script>
  const givingTuesdaySection = document.getElementById("giving-tuesday-2026");
  const givingTuesdayCutoff = new Date(2026, 11, 2);

  if (givingTuesdaySection && new Date() >= givingTuesdayCutoff) {
    givingTuesdaySection.hidden = true;
  }
</script>

<script>
  const carousel = document.querySelector("[data-photo-carousel]");

  if (carousel instanceof HTMLElement) {
    const photos = JSON.parse(carousel.dataset.photos ?? "[]");
    const slides = Array.from(carousel.querySelectorAll("[data-carousel-slide]"));
    const previousButton = carousel.querySelector("[data-carousel-previous]");
    const nextButton = carousel.querySelector("[data-carousel-next]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (
      photos.length > slides.length &&
      slides.every((slide) => slide instanceof HTMLElement) &&
      previousButton instanceof HTMLButtonElement &&
      nextButton instanceof HTMLButtonElement
    ) {
      let firstPhoto = 0;
      let manuallyPaused = reducedMotion.matches;
      let pointerInside = false;
      let focusInside = false;
      let rotationTimer: number | undefined;

      const renderSlides = () => {
        slides.forEach((slide, offset) => {
          const photoIndex = (firstPhoto + offset) % photos.length;
          const photo = photos[photoIndex];
          const image = slide.querySelector("[data-carousel-image]");
          const caption = slide.querySelector("[data-carousel-caption]");

          if (image instanceof HTMLImageElement && caption instanceof HTMLElement) {
            image.src = photo.src;
            image.alt = photo.alt;
            image.classList.toggle("photo-carousel__image--contain", photo.fit === "contain");
            caption.textContent = photo.caption;
            slide.setAttribute("aria-label", `${photoIndex + 1} of ${photos.length}`);
          }
        });
      };

      const syncRotation = () => {
        window.clearInterval(rotationTimer);
        if (manuallyPaused || pointerInside || focusInside || document.hidden) return;
        rotationTimer = window.setInterval(() => {
          firstPhoto = (firstPhoto + 1) % photos.length;
          renderSlides();
        }, 5000);
      };

      const showPrevious = () => {
        firstPhoto = (firstPhoto - 1 + photos.length) % photos.length;
        renderSlides();
        syncRotation();
      };

      const showNext = () => {
        firstPhoto = (firstPhoto + 1) % photos.length;
        renderSlides();
        syncRotation();
      };

      previousButton.addEventListener("click", showPrevious);
      nextButton.addEventListener("click", showNext);

      carousel.addEventListener("mouseenter", () => {
        pointerInside = true;
        syncRotation();
      });
      carousel.addEventListener("mouseleave", () => {
        pointerInside = false;
        syncRotation();
      });
      carousel.addEventListener("focusin", () => {
        focusInside = true;
        syncRotation();
      });
      carousel.addEventListener("focusout", (event) => {
        if (!(event.relatedTarget instanceof Node) || !carousel.contains(event.relatedTarget)) {
          focusInside = false;
          syncRotation();
        }
      });

      document.addEventListener("visibilitychange", syncRotation);
      reducedMotion.addEventListener("change", (event) => {
        manuallyPaused = event.matches;
        syncRotation();
      });

      renderSlides();
      syncRotation();
    }
  }
</script>
