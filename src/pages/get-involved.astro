---
import SiteLayout from "../layouts/BaseLayout.astro";
import heroImage from "../../assets/photos/courier-missions-medical-mother-and-baby.jpg";
---

<SiteLayout title="Get Involved" description="Give, pray, go, and partner with Courier Missions to bring hope and practical help to communities in need." heroImage={heroImage}>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__content">
        <p class="eyebrow">Get involved</p>
        <h1>There are many ways to serve.</h1>
        <p class="section-lead">Whether you give, pray, go, or partner as a church, there is a place for you in this work.</p>
      </div>
      <div class="page-hero__media">
        <img src={heroImage.src} alt="A mother and her baby at the medical camp." width={heroImage.width} height={heroImage.height} loading="eager" />
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container card-grid">
      <article class="mini-card">
        <p class="eyebrow">Give</p>
        <h3>One-time or monthly giving.</h3>
        <p>$10 a month provides lunch for 2 students.</p>
        <a class="button button--primary" href="#donation-link-todo">Donate</a>
      </article>
      <article class="mini-card">
        <p class="eyebrow">Pray</p>
        <h3>Join us in prayer.</h3>
        <p>Pray for the people we serve, for local leaders, and for wisdom in every step of the work.</p>
        <p class="form-note">TODO: Add the prayer email signup provider before launch.</p>
      </article>
      <article class="mini-card">
        <p class="eyebrow">Go</p>
        <h3>Mission trip to Kenya.</h3>
        <p>We welcome people who feel called to serve on the annual mission trip. Trip dates and application details are still pending.</p>
        <a class="text-link" href="/contact/?interest=Go on a trip">Ask about a trip</a>
      </article>
      <article class="mini-card">
        <p class="eyebrow">Partner</p>
        <h3>Partner as a church.</h3>
        <p>Churches can support the work through prayer, giving, and hands-on partnership.</p>
        <a class="text-link" href="/contact/?interest=Partner as a church">Partner with us</a>
      </article>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-cream);">
    <div class="container narrow">
      <p class="eyebrow">Follow along</p>
      <h2 class="section-heading">See what God is doing.</h2>
      <a class="button button--primary" href="https://facebook.com/couriermissions" target="_blank" rel="noreferrer">Follow on Facebook</a>
    </div>
  </section>

  <div class="donate-cta section">
    <div class="container">
      <div class="donate-cta__inner">
        <div>
          <h2>Your gift delivers hope.</h2>
          <p class="donate-cta__copy">Support a meal, a church, a clinic, or a family in crisis.</p>
        </div>
        <div class="donate-cta__actions">
          <a class="button button--primary" href="#donation-link-todo">Donate</a>
          <a class="text-link" href="/contact/">Get in touch</a>
        </div>
      </div>
      <p class="donate-placeholder" id="donation-link-todo">TODO: Add the confirmed donation processor link before publishing. The current Donate buttons are placeholders and do not process gifts.</p>
    </div>
  </div>
</SiteLayout>
