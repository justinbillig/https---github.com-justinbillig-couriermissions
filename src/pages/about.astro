---
import SiteLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site.js";
import heroImage from "../../assets/photos/hero-volunteer-with-students.jpg";
---

<SiteLayout title="About" description="We're a volunteer-led Christian nonprofit from Indiana, working alongside churches and local leaders in Kenya, Sierra Leone and the U.S." heroImage={heroImage}>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__content">
        <p class="eyebrow">About</p>
        <h1>About Courier Missions</h1>
        <p class="section-lead">We're a volunteer-led 501(c)(3) Christian nonprofit from Indiana. We work alongside pastors and local leaders in Kenya, Sierra Leone and here at home—feeding students, building churches and showing up when disaster hits.</p>
      </div>
      <div class="page-hero__media">
        <img src={heroImage.src} alt="A Courier Missions volunteer with students in Kakamega, Kenya." width={heroImage.width} height={heroImage.height} loading="eager" />
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-grid content-grid--split">
      <div>
        <p class="eyebrow">Mission</p>
        <h2>We believe faith means showing up.</h2>
        <p>A meal at school. A church where people can worship. A Bible in someone’s hands. We come alongside local leaders to meet real needs and share the hope of Christ—in Kenya, Sierra Leone and here at home.</p>
      </div>
      <div>
        <p class="eyebrow">Vision</p>
        <h2>We want churches to grow stronger, local leaders to be equipped, and communities to have help when crises come—all through Christ-centered work that can last.</h2>
      </div>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-cream);">
    <div class="container">
      <p class="eyebrow">Our philosophy</p>
      <h2 class="section-heading">Empower, Respond, Transform.</h2>
      <div class="card-grid">
        <article class="mini-card">
          <span class="mini-card__icon">01</span>
          <h3>Empower</h3>
          <p>Scholarships, Harvest of Hope, local jobs and church buildings. We come alongside people as they build for the future.</p>
        </article>
        <article class="mini-card">
          <span class="mini-card__icon">02</span>
          <h3>Respond</h3>
          <p>When floods hit or a need arises, we help bring food, supplies and medical care where they are needed.</p>
        </article>
        <article class="mini-card">
          <span class="mini-card__icon">03</span>
          <h3>Transform</h3>
          <p>We work with local churches, schools and leaders. The goal is work that can keep going in the community.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <p class="eyebrow">Leadership</p>
      <h2 class="section-heading">Three Co-Directors. Twelve volunteers. One shared purpose.</h2>
      <div class="card-grid">
        <article class="mini-card">
          <h3>Heather Billig</h3>
          <p>Co-Director</p>
        </article>
        <article class="mini-card">
          <h3>Corey Potts</h3>
          <p>Co-Director</p>
        </article>
        <article class="mini-card">
          <h3>Sam Fox</h3>
          <p>Sam is an experienced farmer who advises Harvest of Hope.</p>
        </article>
        <article class="mini-card">
          <h3>Mark Abungana</h3>
          <p>Mark leads Courier Mission CBO and the day-to-day work in Kakamega.</p>
        </article>
      </div>
      <p class="section-lead">Heather, Corey and Sam serve as volunteer Co-Directors and as the Board of Directors. Twelve volunteers help carry the work forward.</p>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-white);">
    <div class="container">
      <p class="eyebrow">Stewardship</p>
      <h2 class="section-heading">Here’s how we keep you close to the work.</h2>
      <ul class="list-check">
        <li>Every week, we meet by video with our Kenya Project Manager to talk through progress and spending.</li>
        <li>We share regular video updates from the field so you can see the work.</li>
        <li>We keep receipts for every purchase and every worker’s wage.</li>
        <li>Our Co-Directors visit Kenya every year to see the work firsthand.</li>
      </ul>
    </div>
  </section>

  <div class="donate-cta section">
    <div class="container">
      <div class="donate-cta__inner">
        <div>
          <h2>Thank you for being part of this.</h2>
          <p class="donate-cta__copy">Your gift helps meet real needs and share the hope of Christ.</p>
        </div>
        <div class="donate-cta__actions">
          <a class="button button--primary" href={site.donateHref}>Donate</a>
          <a class="text-link" href="/get-involved/">Other ways to give</a>
        </div>
      </div>
    </div>
  </div>
</SiteLayout>
