---
import SiteLayout from "../layouts/BaseLayout.astro";
import heroImage from "../../assets/photos/hero-volunteer-with-students.jpg";
---

<SiteLayout title="About" description="Courier Missions is a U.S.-based Christian nonprofit serving communities through practical help, education, and spiritual hope." heroImage={heroImage}>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__content">
        <p class="eyebrow">About</p>
        <h1>About Courier Missions</h1>
        <p class="section-lead">Courier Missions is a U.S.-based 501(c)(3) Christian nonprofit serving vulnerable communities through humanitarian aid, education, sustainable development and community partnership. We serve in the United States, Kenya and Sierra Leone, with a focus on poverty, food insecurity, limited access to education, and essential resources.</p>
      </div>
      <div class="page-hero__media">
        <img src={heroImage.src} alt="A Courier Missions volunteer with students in Kakamega, Kenya." width={heroImage.width} height={heroImage.height} loading="eager" />
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-grid content-grid--split">
      <div>
        <p class="eyebrow">Mission</p>
        <h2>Practical help and spiritual hope.</h2>
        <p>Courier Missions exists to serve communities and churches in need around the world by providing practical help and spiritual hope. We partner with local leaders to bring lasting transformation through humanitarian aid, volunteer service, education, employment, and discipleship. Our mission is to deliver hope, meet real needs, and empower communities to grow stronger and more resilient for the future.</p>
      </div>
      <div>
        <p class="eyebrow">Vision</p>
        <h2>To strengthen churches, empower leaders, and respond to crises through sustainable, Christ-centered ministry, locally and globally.</h2>
      </div>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-cream);">
    <div class="container">
      <p class="eyebrow">Our philosophy</p>
      <h2 class="section-heading">Empower, Respond, Transform.</h2>
      <div class="card-grid">
        <article class="mini-card">
          <span class="mini-card__icon">01</span>
          <h3>Empower</h3>
          <p>Scholarships, farming, jobs, and infrastructure that help people move from crisis toward stability and growth.</p>
        </article>
        <article class="mini-card">
          <span class="mini-card__icon">02</span>
          <h3>Respond</h3>
          <p>Disaster relief, food assistance, and medical outreach that meet urgent needs with practical support.</p>
        </article>
        <article class="mini-card">
          <span class="mini-card__icon">03</span>
          <h3>Transform</h3>
          <p>Partnering with local churches, schools and leaders for long-term self-sufficiency and lasting community renewal.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <p class="eyebrow">Leadership</p>
      <h2 class="section-heading">A small, volunteer-led team serving with purpose.</h2>
      <div class="card-grid">
        <article class="mini-card">
          <h3>Heather Billig</h3>
          <p>Co-Director</p>
        </article>
        <article class="mini-card">
          <h3>Corey Potts</h3>
          <p>Co-Director</p>
        </article>
        <article class="mini-card">
          <h3>Sam Fox</h3>
          <p>Co-Director. An experienced farmer who advises Harvest of Hope.</p>
        </article>
        <article class="mini-card">
          <h3>Mark Abungana</h3>
          <p>Project Manager, Kenya. Leads Courier Mission CBO and oversees daily operations in Kakamega.</p>
        </article>
      </div>
      <p class="section-lead">Courier Missions is led by three volunteer Co-Directors who serve as its Board of Directors, supported by 12 volunteers.</p>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-white);">
    <div class="container">
      <p class="eyebrow">Stewardship</p>
      <h2 class="section-heading">How we steward your gift.</h2>
      <ul class="list-check">
        <li>Weekly video calls with our Kenya Project Manager to review progress and spending.</li>
        <li>Regular video updates from the field showing the work as it happens.</li>
        <li>Receipts required for every purchase and every worker's wage.</li>
        <li>Our Co-Directors visit Kenya every year to see the work firsthand.</li>
      </ul>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-cream);">
    <div class="container narrow">
      <p class="eyebrow">Statement of faith</p>
      <p class="section-lead">TODO: Add the agreed statement of faith before launch.</p>
    </div>
  </section>

  <div class="donate-cta section">
    <div class="container">
      <div class="donate-cta__inner">
        <div>
          <h2>Your gift delivers hope.</h2>
          <p class="donate-cta__copy">Give to support practical help and spiritual hope around the world.</p>
        </div>
        <div class="donate-cta__actions">
          <a class="button button--primary" href="#donation-link-todo">Donate</a>
          <a class="text-link" href="/get-involved/">Other ways to give</a>
        </div>
      </div>
      <p class="donate-placeholder" id="donation-link-todo">TODO: Add the confirmed donation processor link before publishing. The current Donate buttons are placeholders and do not process gifts.</p>
    </div>
  </div>
</SiteLayout>
