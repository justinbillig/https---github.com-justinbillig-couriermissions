---
import SiteLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site.js";
import { impactOverview } from "../data/impact.js";
import pdfImage from "../../assets/photos/hero-volunteer-with-students.jpg";
---

<SiteLayout title="Impact" description="The 2025 Impact Review highlights feeding, church building, farm growth, and ministry across Kenya and beyond." heroImage={pdfImage}>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__content">
        <p class="eyebrow">2025 Impact Review</p>
        <h1>{impactOverview.title}</h1>
        <p class="section-lead">{impactOverview.summary}</p>
      </div>
      <div class="page-hero__media">
        <img src={pdfImage.src} alt="A Courier Missions volunteer with students in Kakamega, Kenya." width={pdfImage.width} height={pdfImage.height} loading="eager" />
      </div>
    </div>
  </section>

  <section class="stat-band">
    <div class="container">
      <ul class="stat-band__grid">
        {impactOverview.stats.map((stat) => (
          <li class="stat-band__item">
            <span class="stat-band__value">{stat.value}</span>
            <p class="stat-band__label">{stat.label}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-grid">
      <div>
        <p class="eyebrow">International impact</p>
        <h2>Kenya.</h2>
        <ul>
          {impactOverview.international.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <p class="eyebrow">U.S. impact</p>
        <h2>Practical support at home.</h2>
        <ul>
          {impactOverview.us.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <p class="eyebrow">Spiritual impact</p>
        <h2>Faith and discipleship at the center.</h2>
        <ul>
          {impactOverview.spiritual.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="page-section story-block">
    <div class="container">
      <div class="story-block__inner">
        <p class="eyebrow">Closing</p>
        <p class="story-block__mark" aria-hidden="true">“</p>
        <p class="inline-quote">{impactOverview.closing}</p>
      </div>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-cream);">
    <div class="container narrow">
      <p class="eyebrow">Scripture</p>
      <p class="inline-quote">“{impactOverview.scripture.verse}”</p>
      <p class="quote-attribution">{impactOverview.scripture.reference}</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <p class="eyebrow">Download</p>
      <h2 class="section-heading">2025 Impact Review PDF</h2>
      <a class="button button--primary" href="/files/2025-impact-review.pdf">Open the PDF</a>
    </div>
  </section>

  <div class="donate-cta section">
    <div class="container">
      <div class="donate-cta__inner">
        <div>
          <h2>Your gift delivers hope.</h2>
          <p class="donate-cta__copy">Help fund meals, church building, community care, and long-term discipleship.</p>
        </div>
        <div class="donate-cta__actions">
          <a class="button button--primary" href={site.donateHref}>Donate</a>
          <a class="text-link" href="/get-involved/">Other ways to give</a>
        </div>
      </div>
    </div>
  </div>
</SiteLayout>
