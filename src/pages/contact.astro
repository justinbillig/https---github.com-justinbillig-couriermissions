---
import SiteLayout from "../layouts/BaseLayout.astro";
const interest = Astro.url.searchParams.get("interest") ?? "General question";
---

<SiteLayout title="Contact" description="Have a question, want to talk about a trip, or bring your church alongside the work? Send us a note.">
  <section class="page-section">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Get in touch.</h1>
        <p class="section-lead">Have a question? Want to talk about a trip, a church partnership or a gift? Send us a note. We’d be glad to hear from you.</p>
        <ul class="list-check">
          <li><strong>Write to us:</strong> Use the form and tell us what’s on your mind.</li>
          <li><strong>Follow along:</strong> <a href="https://facebook.com/couriermissions" target="_blank" rel="noreferrer">Find Courier Missions on Facebook</a>.</li>
        </ul>
      </div>

      <form class="form-shell" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="bot-field" />
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="interest">How would you like to help?</label>
          <select id="interest" name="interest">
            <option value="General question" selected={interest === "General question"}>General question</option>
            <option value="Give" selected={interest === "Give"}>Give</option>
            <option value="Stock or legacy gift" selected={interest === "Stock or legacy gift"}>Stock or legacy gift</option>
            <option value="Go on a trip" selected={interest === "Go on a trip"}>Go on a trip</option>
            <option value="Partner as a church" selected={interest === "Partner as a church"}>Partner as a church</option>
            <option value="Pray" selected={interest === "Pray"}>Pray</option>
            <option value="Other" selected={interest === "Other"}>Other</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" required></textarea>
        </div>
        <button class="button button--primary" type="submit">Send message</button>
      </form>
    </div>
  </section>
</SiteLayout>
