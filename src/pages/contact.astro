---
import SiteLayout from "../layouts/BaseLayout.astro";
const interest = Astro.url.searchParams.get("interest") ?? "General question";
---

<SiteLayout title="Contact" description="Get in touch with Courier Missions to ask a question, give, go on a trip, or partner as a church.">
  <section class="page-section">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Get in touch.</h1>
        <p class="section-lead">We'd love to hear from you. Whether you have a question, want to give, or are exploring a trip or church partnership, reach out.</p>
        <ul class="list-check">
          <li><strong>Email:</strong> <a href="mailto:info@couriermissions.org">info@couriermissions.org</a></li>
          <li><strong>Facebook:</strong> <a href="https://facebook.com/couriermissions" target="_blank" rel="noreferrer">facebook.com/couriermissions</a></li>
        </ul>
      </div>

      <form class="form-shell" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="bot-field" />
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="interest">How would you like to help?</label>
          <select id="interest" name="interest">
            <option value="General question" selected={interest === "General question"}>General question</option>
            <option value="Give" selected={interest === "Give"}>Give</option>
            <option value="Go on a trip" selected={interest === "Go on a trip"}>Go on a trip</option>
            <option value="Partner as a church" selected={interest === "Partner as a church"}>Partner as a church</option>
            <option value="Pray" selected={interest === "Pray"}>Pray</option>
            <option value="Other" selected={interest === "Other"}>Other</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" required></textarea>
        </div>
        <button class="button button--primary" type="submit">Send message</button>
        <p class="form-note">This form is powered by Netlify Forms. A confirmation message appears after submission.</p>
      </form>
    </div>
  </section>
</SiteLayout>
