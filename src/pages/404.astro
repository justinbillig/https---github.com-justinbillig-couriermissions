---
import SiteLayout from "../layouts/BaseLayout.astro";
---

<SiteLayout title="Page not found" description="The page you were looking for is not here, but there are still ways to help and learn more about Courier Missions.">
  <section class="page-section">
    <div class="container narrow">
      <p class="eyebrow">404</p>
      <h1>This page has gone on a mission.</h1>
      <p class="section-lead">We couldn't find what you were looking for, but there are many ways to keep exploring.</p>
      <div class="page-cta__links">
        <a class="button button--primary" href="/">Back home</a>
        <a class="button button--light" href="#donation-link-todo">Donate</a>
      </div>
      <p class="donate-placeholder" id="donation-link-todo">TODO: Add the confirmed donation processor link before publishing. The current Donate buttons are placeholders and do not process gifts.</p>
    </div>
  </section>
</SiteLayout>
