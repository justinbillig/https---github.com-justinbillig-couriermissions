---
import SiteLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site.js";
import farmImage from "../../../assets/photos/courier-missions-farm-harvest-of-hope-sign.jpg";
---

<SiteLayout title="Feeding Programs" description="375 students at two schools in Kakamega are part of the feeding program. Harvest of Hope grows food for school meals, pastors and families." heroImage={farmImage}>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__content">
        <p class="eyebrow">Feeding Programs · Kenya &amp; Sierra Leone</p>
        <h1>School meals and food from the farm.</h1>
        <p class="section-lead">In Kakamega, 375 students at two schools are part of the feeding program. Harvest of Hope grows food for school meals, local pastors and families facing food insecurity.</p>
      </div>
      <div class="page-hero__media">
        <img src={farmImage.src} alt="The Harvest of Hope farm sign standing in a maize field in Kakamega." width={farmImage.width} height={farmImage.height} loading="eager" />
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-grid">
      <div>
        <p class="eyebrow">Why it matters</p>
        <h2>Many schools in Kakamega don’t offer meals.</h2>
        <p>Where a meal is part of the school day, enrollment has grown. Families know their children will eat.</p>
      </div>
      <div class="info-card">
        <h3>Kenya: school meals</h3>
        <p>275 students at Shiongo Primary School and 100 at the Kakamega School for the Deaf. That’s 375 students across two schools.</p>
        <p><strong>Giving example:</strong> $10 a month can support one student with one meal a day. At the Kakamega School for the Deaf, 100 students receive two meals a day.</p>
      </div>
    </div>
  </section>

  <section class="page-section" id="harvest-of-hope" style="background: var(--cm-cream);">
    <div class="container content-grid content-grid--split">
      <div>
        <p class="eyebrow">Harvest of Hope</p>
        <h2>Planting seeds of faith, food and future.</h2>
        <p>Buying food for hundreds of students adds up. So we started growing it. Harvest of Hope feeds school programs, helps pastors and families facing food insecurity, and provides daily-wage work for 50 local people.</p>
      </div>
      <div class="info-card">
        <h3>From the field to the next harvest</h3>
        <ol>
          <li><strong>Grow.</strong> Corn and beans grow on 2 leased acres.</li>
          <li><strong>Share the harvest.</strong> Food goes to school programs, local pastors and families facing food insecurity.</li>
          <li><strong>Put people to work.</strong> 50 local day laborers earn daily wages and receive breakfast.</li>
          <li><strong>Plant again.</strong> Surplus produce is sold to pay for seed and plowing.</li>
        </ol>
      </div>
    </div>
    <div class="container stat-band" style="margin-top: 2rem;">
      <ul class="stat-band__grid">
        <li class="stat-band__item"><span class="stat-band__value">2</span><p class="stat-band__label">acres</p></li>
        <li class="stat-band__item"><span class="stat-band__value">50</span><p class="stat-band__label">workers</p></li>
        <li class="stat-band__item"><span class="stat-band__value">1</span><p class="stat-band__label">profitable first harvest</p></li>
        <li class="stat-band__item"><span class="stat-band__value">14 ft</span><p class="stat-band__label">hand-dug well</p></li>
      </ul>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-grid content-grid--split">
      <div class="info-card">
        <p class="eyebrow">The well</p>
        <h3>When the rains didn't come, we dug a well.</h3>
        <p>A 14 ft, hand-dug, brick-lined well with a diesel pump keeps crops watered through dry seasons.</p>
      </div>
      <div>
        <p class="eyebrow">Who runs it</p>
        <h2>Local leadership and practical expertise.</h2>
        <p>Mark Abungana and a local agricultural specialist lead the farm. Co-Director Sam Fox, an experienced farmer, advises them.</p>
      </div>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-white);">
    <div class="container">
      <p class="eyebrow">Where it's going</p>
      <h2 class="section-heading">The goal: 10 acres.</h2>
      <p>Harvest of Hope now grows on 2 leased acres. The goal is 10 total acres, with more irrigation, so the farm can help feed two more schools—about 500 more students, or about 875 across four schools. Two harvests a year are usual. With good weather and irrigation, a third may be possible.</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <p class="eyebrow">Sierra Leone</p>
      <h2 class="section-heading">Meals for children and families in Sierra Leone.</h2>
      <p>We work with local partners to help provide meals to children and families facing food insecurity.</p>
    </div>
  </section>

  <div class="donate-cta section">
    <div class="container">
      <div class="donate-cta__inner">
        <div>
          <h2>Help keep school meals going.</h2>
          <p class="donate-cta__copy">Your gift helps with meals and keeps Harvest of Hope growing.</p>
        </div>
        <div class="donate-cta__actions">
          <a class="button button--primary" href={site.donateHref}>Donate</a>
          <a class="text-link" href="/our-work/">See more ways we serve</a>
        </div>
      </div>
    </div>
  </div>
</SiteLayout>
