---
import SiteLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site.js";
import { reliefNeeds, supportPrograms } from "../../data/relief.js";
---

<SiteLayout title="Ministry Support" description="From flood relief in Indiana to Bibles at Eshiongo Church, see how Courier Missions comes alongside people with practical care.">
  <section class="page-hero page-hero--navy">
    <div class="container page-hero__inner">
      <div class="page-hero__content">
        <p class="eyebrow">Indiana · Kenya</p>
        <h1>Ministry Support</h1>
        <p class="section-lead">More than 25 totes of supplies went to residents affected by flooding in Connersville and Metamora. In Kenya, 30 Bibles were delivered to Eshiongo Church. Here are a few ways we show up.</p>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="support-programs">
        {supportPrograms.map((program) => (
          <article class="info-card support-program" id={program.id}>
            {program.eyebrow && <p class="eyebrow">{program.eyebrow}</p>}
            <h2>{program.title}</h2>
            <p>{program.summary}</p>
            {program.id === "disaster-relief" && reliefNeeds.length > 0 && (
              <div class="page-cta">
                <h3>Current needs</h3>
                <ul class="list-check">
                  {reliefNeeds.map((need) => <li>{need.label}</li>)}
                </ul>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="donate-cta section">
    <div class="container">
      <div class="donate-cta__inner">
        <div>
          <h2>Your gift helps us show up.</h2>
          <p class="donate-cta__copy">Your gift helps us respond to needs close to home and farther away.</p>
        </div>
        <div class="donate-cta__actions">
          <a class="button button--primary" href={site.donateHref}>Donate</a>
          <a class="text-link" href="/our-work/">See all the work</a>
        </div>
      </div>
    </div>
  </div>
</SiteLayout>
