---
import SiteLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site.js";
import churchImage from "../../../assets/photos/courier-missions-church-4-finished-church.jpg";
import foundationImage from "../../../assets/photos/courier-missions-church-1-foundation-framing.jpg";
import wallsImage from "../../../assets/photos/courier-missions-church-2-walls-going-up.jpg";
import roofImage from "../../../assets/photos/courier-missions-church-3-roof-trusses.jpg";
import { churchProjects } from "../../data/churches.js";
---

<SiteLayout title="Church Building" description="Five church projects were reported complete in 2026. Work began on a permanent church for the Shiango congregation in October." heroImage={churchImage}>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__content">
        <p class="eyebrow">Church Building</p>
        <h1>Five churches finished. Shiango is underway.</h1>
        <p class="section-lead">Congregations lead the work. We come alongside them as they build places to worship, gather and serve their neighbors.</p>
      </div>
      <div class="page-hero__media">
        <img src={churchImage.src} alt="A completed church building with green trim and an access ramp." width={churchImage.width} height={churchImage.height} loading="eager" />
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-grid content-grid--split">
      <div>
        <p class="eyebrow">Why it matters</p>
        <h2>In Shiango, the congregation had been meeting under sticks and tarps.</h2>
        <p>In October 2026, work began on a permanent church. The first step was the foundation.</p>
      </div>
      <div class="info-card">
        <p class="eyebrow">How a church takes shape</p>
        <ol>
          <li><strong>First, the foundation and walls.</strong> Local builders take the walls to lintel level.</li>
          <li><strong>Then, the roof and floor.</strong> The building takes shape and becomes more usable.</li>
          <li><strong>Finally, the finishing work.</strong> Local workers add windows, doors, plaster and paint.</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-cream);">
    <div class="container">
      <p class="eyebrow">Our partnership</p>
      <p class="section-lead">Local leaders and the congregation set the pace. We help fund the work and keep you up to date with photos, videos and receipts.</p>
      <div class="info-card" style="margin-top: 1.5rem;">
        <h2>Built by local hands.</h2>
        <p>A church and restroom facility costs about $15,000. A typical facility includes a water tank, two or three lockable stalls—each with a sink, toilet and shower head—handwashing stations, and electricity.</p>
        <p>Local contractors and workers earn daily wages. Construction happens in three phases: foundation and walls; roof and floor; then windows, doors, plaster and paint.</p>
        <p>That’s an approximate cost. Gifts through our donation link go to the general fund, not a specific project.</p>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <p class="eyebrow">Church projects</p>
      <h2 class="section-heading">The work so far.</h2>
      <div class="project-grid">
        {churchProjects.map((project) => (
          <article class="project-card">
            <div class="project-card__top">
              <h3>{project.name}</h3>
              <span class="status-badge">{project.status}</span>
            </div>
            <p><strong>{project.community}</strong> · {project.year}</p>
            <p>{project.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-sky);">
    <div class="container">
      <p class="eyebrow">From foundation to finished church</p>
      <h2 class="section-heading">One step at a time.</h2>
      <p class="church-carousel__hint">Scroll to see all four stages.</p>
      <div
        class="church-carousel"
        role="region"
        aria-label="Church construction photo sequence"
        tabindex="0"
      >
        <div class="church-carousel__track">
          <figure>
            <img src={foundationImage.src} alt="Foundation and timber framing for a new church." width={foundationImage.width} height={foundationImage.height} loading="lazy" />
            <figcaption><strong>First, the foundation.</strong> Block foundation and timber framing.</figcaption>
          </figure>
          <figure>
            <img src={wallsImage.src} alt="A builder on a ladder raising the walls of a church." width={wallsImage.width} height={wallsImage.height} loading="lazy" />
            <figcaption><strong>Then, the walls.</strong> Local builders take the walls to lintel level.</figcaption>
          </figure>
          <figure>
            <img src={roofImage.src} alt="Roof trusses going up on a new church." width={roofImage.width} height={roofImage.height} loading="lazy" />
            <figcaption><strong>Next, the roof.</strong> Trusses go up and the floor is screeded.</figcaption>
          </figure>
          <figure>
            <img src={churchImage.src} alt="A completed church building with green trim and an access ramp." width={churchImage.width} height={churchImage.height} loading="lazy" />
            <figcaption><strong>At last, a finished church.</strong> Ready for the congregation to gather.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <div class="donate-cta section">
    <div class="container">
      <div class="donate-cta__inner">
        <div>
          <h2>Come alongside a congregation.</h2>
          <p class="donate-cta__copy">Your gift helps us work with congregations as they build. Gifts go to our general fund.</p>
        </div>
        <div class="donate-cta__actions">
          <a class="button button--primary" href={site.donateHref}>Donate</a>
          <a class="text-link" href="/our-work/">See all the work</a>
        </div>
      </div>
    </div>
  </div>
</SiteLayout>
