---
import SiteLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site.js";
import churchImage from "../../../assets/photos/courier-missions-church-4-finished-church.jpg";
import ribbonImage from "../../../assets/photos/courier-missions-church-5-ribbon-cutting.jpg";
import worshipImage from "../../../assets/photos/courier-missions-church-6-full-for-worship.jpg";
import { churchProjects } from "../../data/churches.js";
---

<SiteLayout title="Church Building" description="We partner with local congregations to build churches that become centers for worship, fellowship, and community help." heroImage={churchImage}>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__content">
        <p class="eyebrow">Church Building</p>
        <h1>Building churches that serve whole communities.</h1>
        <p class="section-lead">We partner with local congregations to build churches that become centers for worship, fellowship, outreach and practical help.</p>
      </div>
      <div class="page-hero__media">
        <img src={churchImage.src} alt="A completed church building with green trim and an access ramp." width={churchImage.width} height={churchImage.height} loading="eager" />
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-grid content-grid--split">
      <div>
        <p class="eyebrow">Why it matters</p>
        <h2>Many congregations meet in temporary or unfinished buildings.</h2>
        <p>A finished church gives a community a lasting place to gather, serve and care for its neighbors.</p>
      </div>
      <div class="info-card">
        <p class="eyebrow">How we build</p>
        <ol>
          <li><strong>Foundation:</strong> local leaders and builders lay the foundation and framing.</li>
          <li><strong>Walls:</strong> walls go up, built by local workers.</li>
          <li><strong>Roof:</strong> trusses and roofing make the building usable in every season.</li>
          <li><strong>Complete:</strong> finishing work, then the congregation dedicates the building.</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-cream);">
    <div class="container">
      <p class="eyebrow">Our partnership</p>
      <p class="section-lead">The congregation and local leaders lead the project, Courier Missions provides funding and support, and progress is documented with photos, video updates and receipts.</p>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <p class="eyebrow">Church projects</p>
      <h2 class="section-heading">Current and completed church work.</h2>
      <div class="project-grid">
        {churchProjects.map((project) => (
          <article class="project-card">
            <div class="project-card__top">
              <h3>{project.name}</h3>
              <span class="status-badge">{project.status}</span>
            </div>
            <p><strong>{project.community}</strong> · {project.year}</p>
            <p>{project.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-sky);">
    <div class="container">
      <div class="gallery-grid">
        <figure><img src={ribbonImage.src} alt="A ribbon-cutting celebrating a new church." width={ribbonImage.width} height={ribbonImage.height} loading="lazy" /></figure>
        <figure><img src={worshipImage.src} alt="A full church gathered for worship." width={worshipImage.width} height={worshipImage.height} loading="lazy" /></figure>
      </div>
    </div>
  </section>

  <div class="donate-cta section">
    <div class="container">
      <div class="donate-cta__inner">
        <div>
          <h2>Help build a church.</h2>
          <p class="donate-cta__copy">Your gift helps local congregations grow into welcoming places of worship, care, and hope.</p>
        </div>
        <div class="donate-cta__actions">
          <a class="button button--primary" href={site.donateHref}>Donate</a>
          <a class="text-link" href="/our-work/">Explore all ministry areas</a>
        </div>
      </div>
    </div>
  </div>
</SiteLayout>
