---
import SiteLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site.js";
import { ministryAreas, moreWaysWeServe } from "../../data/our-work.js";
import feedingImage from "../../../assets/photos/feeding-program-serving-line.jpg";
import schoolImage from "../../../assets/photos/courier-missions-feeding-food-delivery-to-school.jpg";
import churchImage from "../../../assets/photos/courier-missions-church-4-finished-church.jpg";

const areaPhotos = {
  "Feeding Programs": feedingImage,
  "Kakamega School for the Deaf": schoolImage,
  "Church Building": churchImage,
};
---

<SiteLayout title="Our Work" description="We work alongside trusted local leaders to feed children, build churches, and respond to disasters with practical help and spiritual hope.">
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__content">
        <p class="eyebrow">Our work</p>
        <h1>Our work</h1>
        <p class="section-lead">We work alongside trusted local leaders who know their communities best. Our goal isn't only to meet urgent needs, but to build lasting, locally led solutions.</p>
      </div>
      <div class="page-hero__media">
        <img src={feedingImage.src} alt="Volunteers serving a meal to students and an elder in Kenya." width={feedingImage.width} height={feedingImage.height} loading="eager" />
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="card-grid">
        {ministryAreas.map((area) => (
          <article class="mini-card">
            {areaPhotos[area.title] ? (
              <img src={areaPhotos[area.title].src} alt={area.alt} width={areaPhotos[area.title].width} height={areaPhotos[area.title].height} loading="lazy" />
            ) : (
              <div class="ministry-card__visual" aria-hidden="true">
                <span>Ministry support</span>
              </div>
            )}
            <div style="padding-top: 1rem;">
              <h3>{area.title}</h3>
              <p>{area.summary}</p>
              <a class="text-link" href={area.href}>Learn more <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
      <a class="text-link" href="/our-work/ministry-support/">Explore Ministry Support <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-cream);">
    <div class="container">
      <p class="eyebrow">More ways we serve</p>
      <h2 class="section-heading">Practical care in many forms.</h2>
      <div class="card-grid">
        {moreWaysWeServe.map((item, index) => (
          <article class="mini-card">
            <span class="mini-card__icon">{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            <a class="text-link" href={item.href}>Learn more <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="donate-cta section">
    <div class="container">
      <div class="donate-cta__inner">
        <div>
          <h2>Your gift delivers hope.</h2>
          <p class="donate-cta__copy">Give to support feeding, church building, education, and immediate relief.</p>
        </div>
        <div class="donate-cta__actions">
          <a class="button button--primary" href={site.donateHref}>Donate</a>
          <a class="text-link" href="/get-involved/">Other ways to give</a>
        </div>
      </div>
    </div>
  </div>
</SiteLayout>
