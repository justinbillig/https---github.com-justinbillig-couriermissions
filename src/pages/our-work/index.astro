---
import SiteLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site.js";
import { ministryAreas, moreWaysWeServe } from "../../data/our-work.js";
import feedingImage from "../../../assets/photos/courier-missions-feeding-volunteers-serving-lunch.jpg";
import schoolImage from "../../../assets/photos/courier-missions-feeding-food-delivery-to-school.jpg";
import churchImage from "../../../assets/photos/courier-missions-church-4-finished-church.jpg";
import clinicImage from "../../../assets/photos/courier-missions-medical-blood-pressure-check.jpg";
import supportImage from "../../../assets/photos/flood-relief-supply-table.jpg";

const areaPhotos = {
  "Feeding Programs": feedingImage,
  "Kakamega School for the Deaf": schoolImage,
  "Church Building": churchImage,
  "Medical Clinics": clinicImage,
  "Ministry Support": supportImage,
};
---

<SiteLayout title="Our Work" description="From school meals in Kakamega to flood relief in Indiana, see the work Courier Missions does alongside local churches and leaders.">
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__content">
        <p class="eyebrow">Our work</p>
        <h1>Our work</h1>
        <p class="section-lead">In Kakamega, 375 students are part of school feeding programs, and work has begun on a permanent church in Shiango. From Kenya to Indiana, we come alongside local leaders to meet needs and share hope.</p>
      </div>
      <div class="page-hero__media">
        <img src={feedingImage.src} alt="Volunteers serving lunch to children from large buckets." width={feedingImage.width} height={feedingImage.height} loading="eager" />
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <div class="card-grid ministry-area-grid">
        {ministryAreas.map((area) => (
          <article class="mini-card">
            {areaPhotos[area.title] ? (
              <img src={areaPhotos[area.title].src} alt={area.alt} width={areaPhotos[area.title].width} height={areaPhotos[area.title].height} loading="lazy" />
            ) : (
              <div class="ministry-card__visual" aria-hidden="true">
                <span>Ministry support</span>
              </div>
            )}
            <div style="padding-top: 1rem;">
              <h3>{area.title}</h3>
              <p>{area.summary}</p>
              <a class="text-link" href={area.href}>See this work <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
      <a class="text-link" href="/our-work/ministry-support/">See more ways we serve <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-cream);">
    <div class="container">
      <p class="eyebrow">More ways we serve</p>
      <h2 class="section-heading">There’s more to the work.</h2>
      <div class="card-grid">
        {moreWaysWeServe.map((item, index) => (
          <article class="mini-card">
            <span class="mini-card__icon">{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            <a class="text-link" href={item.href}>See this work <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="donate-cta section">
    <div class="container">
      <div class="donate-cta__inner">
        <div>
          <h2>You can help carry the work forward.</h2>
          <p class="donate-cta__copy">Your gift helps with meals, church building, school essentials and relief when disaster hits.</p>
        </div>
        <div class="donate-cta__actions">
          <a class="button button--primary" href={site.donateHref}>Donate</a>
          <a class="text-link" href="/get-involved/">Other ways to give</a>
        </div>
      </div>
    </div>
  </div>
</SiteLayout>
