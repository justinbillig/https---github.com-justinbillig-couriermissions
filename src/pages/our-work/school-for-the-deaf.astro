---
import SiteLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site.js";
import foodDeliveryImage from "../../../assets/photos/courier-missions-feeding-food-delivery-to-school.jpg";
import mealPrepImage from "../../../assets/photos/courier-missions-feeding-team-dishing-up-meals.jpg";
---

<SiteLayout title="Kakamega School for the Deaf" description="Every day, 100 students at Kakamega School for the Deaf receive meals. Monthly food deliveries, mattresses and blankets help meet other needs." heroImage={foodDeliveryImage}>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__content">
        <p class="eyebrow">Kakamega, Kenya</p>
        <h1>Kakamega School for the Deaf</h1>
        <p class="section-lead">Every day, 100 students receive meals. We’ve stood alongside the school since Courier Missions’ first year.</p>
      </div>
      <div class="page-hero__media">
        <img src={foodDeliveryImage.src} alt="Sacks of food delivered to students at the Kakamega School for the Deaf." width={foodDeliveryImage.width} height={foodDeliveryImage.height} loading="eager" />
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container content-grid content-grid--split">
      <div>
        <p class="eyebrow">Why it matters</p>
        <h2>In 2025, we began providing two meals a day.</h2>
        <p>Food deliveries, mattresses and blankets, and daily security are part of the work at the school.</p>
      </div>
      <div class="info-card">
        <p class="eyebrow">What we do</p>
        <ul class="list-check">
          <li><strong>Meals:</strong> Two meals a day for the school’s 100 students.</li>
          <li><strong>Food deliveries:</strong> Each month, the school receives food, including fresh vegetables from Harvest of Hope and special meals with meat.</li>
          <li><strong>Mattresses and blankets:</strong> 85 were provided in 2025.</li>
          <li><strong>Daily security:</strong> A guard helps protect students and food when teachers are away. The approximate cost is $150 a month. This is not 24/7 coverage.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-cream);">
    <div class="container">
      <div class="gallery-grid">
        <figure><img src={foodDeliveryImage.src} alt="Sacks of food delivered to students at the Kakamega School for the Deaf." width={foodDeliveryImage.width} height={foodDeliveryImage.height} loading="lazy" /></figure>
        <figure><img src={mealPrepImage.src} alt="Volunteers plating meals in a school kitchen." width={mealPrepImage.width} height={mealPrepImage.height} loading="lazy" /></figure>
      </div>
    </div>
  </section>

  <div class="donate-cta section">
    <div class="container">
      <div class="donate-cta__inner">
        <div>
          <h2>Come alongside the students.</h2>
          <p class="donate-cta__copy">Your gift can help with meals, food deliveries and daily security. Gifts go to our general fund.</p>
        </div>
        <div class="donate-cta__actions">
          <a class="button button--primary" href={site.donateHref}>Donate</a>
          <a class="text-link" href="/our-work/">See all the work</a>
        </div>
      </div>
    </div>
  </div>
</SiteLayout>
