---
import { getImage, Picture } from "astro:assets";
import SiteLayout from "../layouts/BaseLayout.astro";
import heroSource from "../../assets/photos/hero-volunteer-with-students.jpg";
import feedingPhoto from "../../assets/photos/courier-missions-feeding-volunteers-serving-lunch.jpg";
import churchPhoto from "../../assets/photos/courier-missions-church-4-finished-church.jpg";
import medicalPhoto from "../../assets/photos/courier-missions-medical-blood-pressure-check.jpg";
import farmPhoto from "../../assets/photos/courier-missions-farm-harvest-of-hope-sign.jpg";
import { homePage } from "../data/home.js";
import { site } from "../data/site.js";
import schoolPhoto from "../../assets/photos/courier-missions-feeding-food-delivery-to-school.jpg";
import supportPhoto from "../../assets/photos/flood-relief-supply-table.jpg";

const programPhotos = {
  feeding: feedingPhoto,
  school: schoolPhoto,
  church: churchPhoto,
  medical: medicalPhoto,
  support: supportPhoto,
};

const heroPhoto = await getImage({
  src: heroSource,
  width: 1600,
  format: "avif",
  quality: 65,
});
---

<SiteLayout
  title="Home"
  description={homePage.description}
  transparentHeader={true}
  heroImage={heroPhoto}
>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero__photo">
      <img
        src={heroPhoto.src}
        alt="A Courier Missions volunteer smiling with students in Kakamega, Kenya."
        width={heroPhoto.width}
        height={heroPhoto.height}
        fetchpriority="high"
        loading="eager"
      />
    </div>
    <div class="hero__content">
      <p class="eyebrow hero__eyebrow">Kenya · Sierra Leone · Indiana</p>
      <h1 id="home-title">{homePage.title}</h1>
      <p class="hero__lead">{homePage.description}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={site.donateHref}>Donate</a>
        <a class="button button--dark" href="#our-work">See our work</a>
      </div>
    </div>
  </section>

  <section class="mission section" aria-labelledby="mission-title">
    <div class="container">
      <div class="mission__intro">
        <p class="eyebrow">Our mission</p>
        <h2 class="section-heading" id="mission-title">Meals, churches and Bibles.</h2>
        <p class="section-lead">{homePage.mission}</p>
      </div>
      <ol class="pillars">
        {homePage.pillars.map((pillar) => (
          <li class="pillar-card">
            <span class="pillar-card__number" aria-label={`Pillar ${pillar.number}`}>{pillar.number}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="programs section" id="our-work" aria-labelledby="programs-title">
    <div class="container">
      <p class="eyebrow">Our work</p>
      <h2 class="section-heading" id="programs-title">The work we do together.</h2>
      <p class="section-lead">375 students are part of school feeding programs in Kakamega. Alongside local churches and leaders, we also build churches, hold clinics and respond when disaster hits.</p>
      <div class="program-grid">
        {homePage.programs.map((program) => (
          <article class="program-card">
            <div class="program-card__image">
              <Picture
                src={programPhotos[program.image]}
                formats={["avif", "webp"]}
                widths={[320, 480, 640]}
                sizes="(max-width: 599px) 100vw, (max-width: 899px) 50vw, 33vw"
                alt={program.alt}
                loading="lazy"
              />
            </div>
            <div class="program-card__body">
              <h3>{program.title}</h3>
              <p>{program.description}</p>
              <a class="text-link" href={program.href}>See this work <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
      <a class="text-link" href="/our-work/">See all the work <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="page-section" style="background: var(--cm-cream);">
    <div class="container content-grid content-grid--split">
      <div>
        <p class="eyebrow">Harvest of Hope</p>
        <h2>{homePage.farmFeature.title}</h2>
        <p>{homePage.farmFeature.description}</p>
        <a class="text-link" href="/our-work/feeding/#harvest-of-hope">{homePage.farmFeature.linkLabel} <span aria-hidden="true">→</span></a>
      </div>
      <div class="page-hero__media">
        <img
          src={farmPhoto.src}
          alt="The Harvest of Hope farm sign standing in a maize field in Kakamega."
          width={farmPhoto.width}
          height={farmPhoto.height}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="impact section" aria-labelledby="impact-title">
    <div class="container">
      <p class="eyebrow">The work in numbers · 2026</p>
      <h2 id="impact-title">Real work. Real people.</h2>
      <ul class="impact__grid">
        {homePage.impact.map((stat) => (
          <li class="impact-stat">
            <span class="impact-stat__value">{stat.value}</span>
            <p class="impact-stat__label">{stat.label}</p>
            <p class="impact-stat__context">{stat.context}</p>
          </li>
        ))}
      </ul>
      <a class="text-link" href="/impact/">Read the 2025 Impact Review <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="donate-cta section" aria-labelledby="donate-title">
    <div class="container">
      <div class="donate-cta__inner">
        <div>
          <h2 id="donate-title">You can help keep this work going.</h2>
          <p class="donate-cta__copy">Your gift helps us come alongside local churches, schools and leaders.</p>
        </div>
        <div class="donate-cta__actions">
          <a class="button button--primary" href={site.donateHref}>Donate</a>
          <a class="text-link" href="/get-involved/">Other ways to give <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
