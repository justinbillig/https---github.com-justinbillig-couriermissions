---
import footerLogo from "../../assets/logo/logo-horizontal-on-dark.png";
import { site } from "../data/site.js";
---

<footer class="site-footer" id="site-footer">
  <div class="container site-footer__main">
    <div class="site-footer__brand">
      <a href="/" aria-label="Courier Missions home">
        <img src={footerLogo.src} alt="Courier Missions" width="240" height="76" loading="lazy" />
      </a>
      <p class="site-footer__mission">Delivering Hope, Serving with Purpose.</p>
    </div>
    <nav aria-label="Explore">
      <h2 class="site-footer__heading">Explore</h2>
      <ul class="site-footer__links">
        {site.navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div>
      <h2 class="site-footer__heading">Connect</h2>
      <ul class="site-footer__links">
        <li><a href={site.facebookHref} target="_blank" rel="noreferrer">Facebook</a></li>
        <li><a href="/contact/">Contact Us</a></li>
      </ul>
    </div>
    <div>
      <h2 class="site-footer__heading">Give</h2>
      <a class="button button--primary" href={site.donateHref}>Donate</a>
    </div>
  </div>
  <div class="container site-footer__bottom">
    <p>Courier Missions is a 501(c)(3) nonprofit organization. Gifts are tax-deductible as allowed by law.</p>
    <p>© {new Date().getFullYear()} Courier Missions.</p>
    <p>Delivering Hope, Serving with Purpose.</p>
  </div>
</footer>
